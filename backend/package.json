{
  "name": "sales-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sales CRM backend API",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:seed": "node src/seed.js",
    "smoke": "node ../scripts/smoke-crm.mjs",
    "test": "node --test",
    "check": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
