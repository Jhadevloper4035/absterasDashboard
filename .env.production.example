# Copy this file to .env on the EC2 host before starting the app.
# Replace all placeholder values with your real production values.
# This file mirrors the values expected by the GitHub Actions deployment workflow.

NODE_ENV=production
APP_NAME=Sales CRM API
BACKEND_IMAGE=ghcr.io/your-org/sales-crm-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/sales-crm-frontend:latest
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=true

# Use a long random string (at least 32 chars).
AUTH_SECRET=replace-with-a-long-random-secret
SETUP_TOKEN=replace-with-a-long-random-setup-token

# MongoDB connection string for production.
MONGODB_URI=replace-with-your-production-mongodb-uri

# Public app URL. Use your custom domain here.
CORS_ORIGIN=https://crm.absteras.com

# SMTP settings for email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-gmail-address
SMTP_PASS=replace-with-your-app-password
SMTP_FROM=replace-with-your-gmail-address
SMTP_TIMEOUT_MS=5000

# AWS S3 credentials for uploads.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=replace-with-your-s3-bucket-name
S3_UPLOAD_PREFIX=uploads

# GitHub Actions / CI-CD deployment secrets
# Add these as GitHub secrets in the repository:
# DOCKERHUB_USERNAME=your-dockerhub-username
# DOCKERHUB_TOKEN=your-dockerhub-access-token
# DOCKER_IMAGE_NAMESPACE=your-dockerhub-username-or-org
# EC2_HOST=your-ec2-public-ip-or-dns
# EC2_USER=ubuntu
# EC2_SSH_KEY=private-key-for-ec2-user
# EC2_APP_DIR=/opt/absteras-crm
# BACKEND_ENV=full contents of this file
